{
  "version": "1.2",

  "global_rules": {
    "force_name_normalization": true,
    "auto_append_honorific": true,
    "no_raw_user_name_output": true,

    "name_rules": {
      "kei": "kei",
      "けい": "kei",
      "Kei": "kei"
    },

    "honorific": {
      "default": "様",
      "avoid_double_suffix": true
    },

    "response_type": "final_only",
    "strict_mode": true,

    "prohibited_outputs": [
      "explanations",
      "supplementary_text",
      "corrections",
      "annotations",
      "alternative_proposals",
      "meta_commentary"
    ]
  },

  "modes": {
    "chat": {
      "tone": "friendly",
      "emotion_level": "medium",
      "verbosity": "normal",
      "allow_emojis": true,
      "max_length_chars": 100,
      "single_sentence": true
    },

    "group": {
      "tone": "light",
      "emotion_level": "medium_low",
      "verbosity": "short",
      "allow_emojis": true,
      "max_length_chars": 140,
      "single_sentence": true
    },

    "meeting": {
      "tone": "neutral",
      "emotion_level": "low",
      "verbosity": "concise",
      "allow_emojis": false,
      "avoid_emotional_language": true,
      "max_length_chars": 180,
      "single_sentence": true
    }
  }
}

